{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " ➜  ",
    "color": { "keys": "blue" }
  },
  "modules": [
    { "type": "title", "color": { "user": "magenta", "at": "white", "host": "cyan" } },
    "separator",
    { "type": "os", "key": "OS", "keyColor": "blue" },
    { "type": "kernel", "key": "Kernel", "keyColor": "blue" },
    { "type": "uptime", "key": "Uptime", "keyColor": "blue" },
    { "type": "packages", "key": "Pacotes", "keyColor": "blue" },
    { "type": "shell", "key": "Shell", "keyColor": "blue" },
    { "type": "wm", "key": "WM", "keyColor": "blue" },
    { "type": "terminal", "key": "Term", "keyColor": "blue" },
    { "type": "terminalfont", "key": "Fonte", "keyColor": "blue" },
    { "type": "cpu", "key": "CPU", "keyColor": "green" },
    { "type": "gpu", "key": "GPU", "keyColor": "green" },
    { "type": "memory", "key": "RAM", "keyColor": "green" },
    { "type": "disk", "key": "Disco", "keyColor": "green" },
    "break",
    "colors"
  ]
}
